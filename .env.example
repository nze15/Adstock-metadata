# Required: Helius RPC Configuration
# Get your API key from https://www.helius.dev/
VITE_HELIUS_API_KEY=your_helius_api_key_here
VITE_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Solana Network Configuration
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_NETWORK=mainnet-beta

# Application Configuration
VITE_TOKEN_MINT=HTEjWCCRSUnp2nHdiAEoVPJDDaWYcRozmZUCRsREBAGS
VITE_APP_URL=http://localhost:5173

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional: Third-party APIs
VITE_BASE44_API_KEY=your_base44_api_key_here
VITE_ANALYTICS_ENABLED=true

# Metadata Update Feature Configuration (NEW)
# Set this to your application URL for shareable metadata update links
